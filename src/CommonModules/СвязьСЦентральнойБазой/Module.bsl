&НаКлиенте
Процедура ВыполнитьПроверкуСвязи(АдресЦентральнойБазы, ЛогинКурьера, ПарольКурьера) Экспорт
	
	// Задаем параметры подключения к Центральной базе. Адрес сервера, имя публикации и пароль, логин курьера
	// АдресСервера = "192.168.0.17"; 
	// ИмяПубликации = "Homework";
	// ЛогинКурьера  = "Администратор";
	// ПарольКурьера = "";
	
	// Формируем путь к нашему HTTP-сервису
	// Схема: /ИмяПубликации/hs/КорневойURL/ШаблонURL
	// ПутьКРесурсу = "/" + ИмяПубликации + "/hs/mobile/ping";
	
	АдресРесурса = ОбработкаАдресаРесурса(АдресЦентральнойБазы);
	
	// Создаем соответствие для заголовков
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type", "application/json");
	Запрос = Новый HTTPЗапрос(АдресРесурса.ИмяПубликации + "/hs/mobile/ping", Заголовки);
	
	Соединение = Новый HTTPСоединение(АдресРесурса.IPАдрес, , ЛогинКурьера, ПарольКурьера, , , , );
	Ответ = Соединение.Получить(Запрос);
	
	Если Ответ.КодСостояния = 200 Тогда
		//ТекстРезультата = Ответ.ПолучитьТелоКакСтроку("UTF-8");
		ПоказатьПредупреждение(, "Соединение установлено.");
	ИначеЕсли Ответ.КодСостояния = 401 Тогда
		ПоказатьПредупреждение(, "Ошибка авторизации: неверный логин или пароль курьера!");
	ИначеЕсли Ответ.КодСостояния = 404 Тогда
		ПоказатьПредупреждение(, "Ошибка 404: неверно указан путь к сервису или база не опубликована.");
	Иначе 
		ПоказатьПредупреждение(, "Ошибка соединения с сервером! Код ошибки: " + Ответ.КодСостояния);
		Возврат;
	КонецЕсли;
КонецПроцедуры 

&НаКлиенте
Функция ОбработкаАдресаРесурса(Адрес) Экспорт 
	
	Результат = Новый Структура;
	
	// http://192.168.0.17/Homework/hs/mobile/ping
	
	// Определяем сетевой протокол
	Если Лев(Адрес, 8) = "https://" Тогда
		СетевойПротокол = "https";
		// БезопасноеСоединение = Истина; 
		ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL;
		URLАдрес = Сред(Адрес, 9);
	ИначеЕсли Лев(Адрес, 7) = "http://" Тогда
		СетевойПротокол = "http";
		ЗащищенноеСоединение = Неопределено;
		URLАдрес = Сред(Адрес, 8); // Определения URL Адреса достаточно для соединения с ЦБ
	КонецЕсли;
	
	// Находим первый слэш "/", который URLАдрес (192.168.0.17) от пути к ресурсу (Homework)
	ПозицияПервогоСлэша = Найти(URLАдрес, "/");
	
	Если ПозицияПервогоСлэша <> 0 Тогда
		// Выделяем имя IP-адрес
		IPАдрес = Лев(URLАдрес, ПозицияПервогоСлэша - 1);
		// Выделяем путь (включая сам слэш)
		ИмяПубликации = Сред(URLАдрес, ПозицияПервогоСлэша);
	Иначе
		// Если слэша нет, значит указан только IP-адрес (192.168.0.17)
		IPАдрес = URLАдрес;
		ИмяПубликации = "/";
	КонецЕсли;
	
	Результат.Вставить("URLАдрес", URLАдрес);
	Результат.Вставить("СетевойАротокол", СетевойПротокол);
	Результат.Вставить("IPАдрес",IPАдрес);
	Результат.Вставить("ИмяПубликации",ИмяПубликации);
	Результат.Вставить("ЗащищенноеСоединение",ЗащищенноеСоединение);
	
	Возврат Результат;
	
КонецФункции

&НаКлиенте
Процедура ПолучитьКоличествоНовыхЗаказовССервера(АдресЦентральнойБазы, ЛогинКурьера, ПарольКурьера) Экспорт
	
	АдресРесурса = ОбработкаАдресаРесурса(АдресЦентральнойБазы);
	
	// Создаем соответствие для заголовков
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("Content-Type", "application/json");
	Запрос = Новый HTTPЗапрос(АдресРесурса.ИмяПубликации + "/hs/mobile/orders", Заголовки);
	
	Соединение = Новый HTTPСоединение(АдресРесурса.IPАдрес, ,ЛогинКурьера,ПарольКурьера, ,30 ,АдресРесурса.ЗащищенноеСоединение, );
	
	Ответ = Соединение.Получить(Запрос);
	
	Если Ответ.КодСостояния = 200 Тогда
		
		// Используем метод получения строки для HTTPОтвет
		СтрокаJSON = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
		
		// Десериализуем (распаковываем) JSON в Структуру 1С
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
		Данные = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();
		
		// Извлекаем значение по ключу "КоличествоЗаказов"
		Количество = Данные.КоличествоЗаказов;
		
		// Формируем красивый текст для курьера
		ТекстРезультата = СтрШаблон("У вас новых заказов: %1 шт.", Количество);
		ПоказатьПредупреждение(, ТекстРезультата);
		
	Иначе
		ПоказатьПредупреждение(, "Ошибка соединения с сервером! Код ошибки: " + Ответ.КодСостояния);
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

