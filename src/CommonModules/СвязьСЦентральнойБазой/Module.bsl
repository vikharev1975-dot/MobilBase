
Функция ОбработкаАдресаРесурса(Адрес) Экспорт 
	
	Результат = Новый Структура;
	
	Если Лев(Адрес, 8) = "https://" Тогда
		СетевойПротокол = "https";
		ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL;
		URLАдрес = Сред(Адрес, 9);
	ИначеЕсли Лев(Адрес, 7) = "http://" Тогда
		СетевойПротокол = "http";
		ЗащищенноеСоединение = Неопределено;
		URLАдрес = Сред(Адрес, 8);
	КонецЕсли;
	
	ПозицияПервогоСлэша = Найти(URLАдрес, "/");
	
	Если ПозицияПервогоСлэша <> 0 Тогда
		IPАдрес = Лев(URLАдрес, ПозицияПервогоСлэша - 1);
		ИмяПубликации = Сред(URLАдрес, ПозицияПервогоСлэша);
	Иначе
		IPАдрес = URLАдрес;
		ИмяПубликации = "/";
	КонецЕсли;
	
	Результат.Вставить("URLАдрес", URLАдрес);
	Результат.Вставить("СетевойАротокол", СетевойПротокол);
	Результат.Вставить("IPАдрес",IPАдрес);
	Результат.Вставить("ИмяПубликации",ИмяПубликации);
	Результат.Вставить("ЗащищенноеСоединение",ЗащищенноеСоединение);
	
	Возврат Результат;
	
КонецФункции

Функция АвторизацияНаСервере(Адрес, Логин, Пароль, Эндпоинт) Экспорт 
	
	Возврат ВыполнитьЗапросКЦентральнойБазе(Адрес, Логин, Пароль, Эндпоинт);
	
КонецФункции

Функция ПолучитьИзмененияСЦентральнойБазы(Адрес, Логин, Пароль, Эндпоинт) Экспорт 
	
	Возврат ВыполнитьЗапросКЦентральнойБазе(Адрес, Логин, Пароль, Эндпоинт);
	
КонецФункции

Функция ВыполнитьЗапросКЦентральнойБазе(Адрес, Логин, Пароль, Эндпоинт)
	
	АдресРесурса = ОбработкаАдресаРесурса(Адрес);
	СисИнфо = Новый СистемнаяИнформация;
	
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("X-Mobile-ID", Строка(СисИнфо.ИдентификаторКлиента));
	
	Запрос = Новый HTTPЗапрос(АдресРесурса.ИмяПубликации + Эндпоинт, Заголовки);
	Соединение = Новый HTTPСоединение(АдресРесурса.IPАдрес, , СокрЛП(Логин), Пароль, , 60, АдресРесурса.ЗащищенноеСоединение);
	
	Возврат Соединение.Получить(Запрос);
	
КонецФункции

// Выполняет запрос данных обмена к HTTP-сервису центральной базы.
//
// Параметры:
//  Адрес - Строка - адрес публикации центральной базы, например "http://server/base".
//  Логин - Строка - логин курьера.
//  Пароль - Строка - пароль курьера.
//  Эндпоинт - Строка - адрес ресурса HTTP-сервиса, например "/hs/mobile/exchange".
//
// Возвращаемое значение:
//  HTTPОтвет - ответ сервиса.
//
Функция ОбменСЦентральнойБазой(Адрес, Логин, Пароль, Эндпоинт) Экспорт 
	
	АдресРесурса = ОбработкаАдресаРесурса(Адрес);
	СисИнфо = Новый СистемнаяИнформация;
	
	Заголовки = Новый Соответствие;
	Заголовки.Вставить("X-Mobile-ID", Строка(СисИнфо.ИдентификаторКлиента));
	
	Запрос = Новый HTTPЗапрос(АдресРесурса.ИмяПубликации + Эндпоинт, Заголовки);
	Соединение = Новый HTTPСоединение(АдресРесурса.IPАдрес, , СокрЛП(Логин), Пароль, , 60, АдресРесурса.ЗащищенноеСоединение);
	
	Возврат Соединение.Получить(Запрос);
	
КонецФункции
