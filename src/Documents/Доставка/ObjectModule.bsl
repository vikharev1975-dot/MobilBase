
Процедура ПриЗаписи(Отказ)

	// Проверяем СтатусДоставки, если отказ, то комментарий должен быть указан.
	Если СтатусДоставки = Перечисления.СтатусыДоставок.ОтклоненаКурьером 
		Или СтатусДоставки = Перечисления.СтатусыДоставок.ОтклоненаКлиентом Тогда
		Если Не ЗначениеЗаполнено(СокрЛП((Комментарий))) Тогда
			Отказ = Истина;
			Сообщить("Не заполнен комментрий с причиной отказа от доставки.");
		КонецЕсли;
	КонецЕсли;
		
КонецПроцедуры
