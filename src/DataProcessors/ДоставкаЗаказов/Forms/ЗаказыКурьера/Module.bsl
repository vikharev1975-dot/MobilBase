&НаСервере
Процедура ЗагрузитьДоставкуНаСервере()
		
	// 1. Настройка подключения (замените на адрес вашего сервера и имя публикации)
	АдресСервера = "192.168.0.18"; // или доменное имя, например "myserver.ru"
	Порт = 80; // или 443 для HTTPS
	Пользователь = "Администратор";
	Пароль = "";
	
	// Путь строится так: /<ИмяПубликации>/hs/<КорневойURLСервиса>/<ШаблонURL>
	ПутьКСервису = "/CentralBase/hs/mobile/exchange"; 
	
	Попытка
		Соединение = Новый HTTPСоединение(АдресСервера, Порт, Пользователь, Пароль, , 30, Неопределено);
		HTTPЗапрос = Новый HTTPЗапрос(ПутьКСервису);
		
		Ответ = Соединение.Получить(HTTPЗапрос);
		
		Если Ответ.КодСостояния = 200 Тогда
			СтрокаJSON = Ответ.ПолучитьТелоКакСтроку(); // Работает
			ЗаписатьДокументыВМобильнуюБазу(СтрокаJSON);
			Сообщить("Доставки успешно загружены!");
		Иначе
			Сообщить("Ошибка сервера. Код: " + Ответ.КодСостояния + " (" + Ответ.ПолучитьТелоКакСтроку() + ")");
		КонецЕсли;
		
	Исключение
		Сообщить("Не удалось подключиться к серверу: " + ОписаниеОшибки());
	КонецПопытки;
	
КонецПроцедуры

&НаКлиенте
Процедура ЗагрузитьДоставку(Команда)
	ЗагрузитьДоставкуНаСервере();
КонецПроцедуры  


&НаСервере
Процедура ЗаписатьДокументыВМобильнуюБазу(СтрокаJSON)
	
	// Читаем JSON в массив структур
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(СтрокаJSON);
	МассивДокументов = ПрочитатьJSON(ЧтениеJSON);  // Работает
	ЧтениеJSON.Закрыть();
	
	Если ТипЗнч(МассивДокументов) <> Тип("Массив") Тогда
		Возврат;
	КонецЕсли;
	
	Для Каждого ДанныеДокумента Из МассивДокументов Цикл
		
		// Получаем ссылку на документ в мобильной базе по УИД из ЦБ
		УникальныйИдентификаторДокумента = Новый УникальныйИдентификатор(ДанныеДокумента.УникальныйИдентификаторДокумента);
		СсылкаНаДокумент = Документы.Доставка.ПолучитьСсылку(УникальныйИдентификаторДокумента);  //  Объект не найден
		
		// Проверяем, есть ли уже такой документ на телефоне
		ДокументОбъект = СсылкаНаДокумент.ПолучитьОбъект();
		Если ДокументОбъект = Неопределено Тогда
			ДокументОбъект = Документы.Доставка.СоздатьДокумент();
			ДокументОбъект.УстановитьСсылкуНового(СсылкаНаДокумент);
		КонецЕсли;
		
		// Заполняем шапку (имена ключей строго как в вашем HTTP-сервисе)
		ДокументОбъект.Номер = ДанныеДокумента.Номер;
		ДокументОбъект.Дата = XMLЗначение(Тип("Дата"), ДанныеДокумента.Дата);
		ДокументОбъект.АдресДоставки = ДанныеДокумента.АдресДоставки;
		
		// Очищаем и заполняем табличную часть Товары
		ДокументОбъект.Товары.Очистить();
		
		Для Каждого ДанныеТовара Из ДанныеДокумента.Товары Цикл
			НоваяСтрока = ДокументОбъект.Товары.Добавить();
			
			// Находим или создаем номенклатуру в мобильной базе
			НоваяСтрока.Номенклатура = НайтиИлиСоздатьНоменклатуру(
				ДанныеТовара.УникальныйНомерНоменклатура, 
				ДанныеТовара.Наименование);
			НоваяСтрока.Количество = ДанныеТовара.Количество;
		КонецЦикла;
		
		// Записываем документ (или проводим: РежимЗаписиДокумента.Проведение)
		Попытка
			ДокументОбъект.Записать();
		Исключение
			Сообщить("Ошибка записи документа №" + ДанныеДокумента.Номер + ": " + ОписаниеОшибки());
		КонецПопытки;
		
	КонецЦикла;
	
КонецПроцедуры  


&НаСервере
Функция НайтиИлиСоздатьНоменклатуру(СтрокаУникальныйИдетификатор, НаименованиеТовара)
	
	УникальныйИдентификаторНоменклатуры = Новый УникальныйИдентификатор(СтрокаУникальныйИдетификатор);
	СсылкаНоменклатуры = Справочники.Номенклатура.ПолучитьСсылку(УникальныйИдентификаторНоменклатуры);
	
	// Проверяем существование элемента в базе без его полной загрузки
	Если СсылкаНоменклатуры.Пустая() ИЛИ СсылкаНоменклатуры.ПолучитьОбъект() = Неопределено Тогда
		НовыйЭлемент = Справочники.Номенклатура.СоздатьЭлемент();
		НовыйЭлемент.УстановитьСсылкуНового(СсылкаНоменклатуры);
		НовыйЭлемент.Наименование = НаименованиеТовара;
		НовыйЭлемент.Записать();
		Возврат НовыйЭлемент.Ссылка;
	КонецЕсли;
	
	// Если наименование в ЦБ изменилось — можно обновить его и в телефоне
	Если СсылкаНоменклатуры.Наименование <> НаименованиеТовара Тогда
		ОбъектНоменклатуры = СсылкаНоменклатуры.ПолучитьОбъект();
		ОбъектНоменклатуры.Наименование = НаименованиеТовара;
		ОбъектНоменклатуры.Записать();
	КонецЕсли;
	
	Возврат СсылкаНоменклатуры;
	
КонецФункции

