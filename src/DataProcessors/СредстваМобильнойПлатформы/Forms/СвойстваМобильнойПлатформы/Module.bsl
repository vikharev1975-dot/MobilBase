&НаКлиенте
Процедура АдресФотоНажатие(Элемент, СтандартнаяОбработка)
	
	СтандартнаяОбработка = Ложь;
	
	#Если МобильноеПриложениеКлиент Тогда
		Если СредстваМультимедиа.ПоддерживаетсяФотоснимок() Тогда
			
			ДанныеФото = СредстваМультимедиа.СделатьФотоснимок();
			
			Если ДанныеФото = Неопределено Тогда
				Возврат;	
			КонецЕсли; 
			
			АдресФото = ПоместитьВоВременноеХранилище(ДанныеФото.ПолучитьДвоичныеДанные(), УникальныйИдентификатор);
			
		КонецЕсли;
	#КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура НабратьНомер(Команда)
	
	#Если МобильноеПриложениеКлиент Тогда
		Если НЕ ЗначениеЗаполнено(ТелефонныйНомер) Тогда
			ПоказатьПредупреждение(, "Введите номер телефона.");
			Возврат;
		КонецЕсли;
		
		Если СредстваТелефонии.ПоддерживаетсяНаборНомера() Тогда
			СредстваТелефонии.НабратьНомер(ТелефонныйНомер, Истина);
		КонецЕсли;
	#КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьКонтакт(Команда)
	
	#Если МобильноеПриложениеКлиент Тогда
		
		Если ПустаяСтрока(ФИО) Тогда
			ПоказатьПредупреждение(, "Заполните поле ФИО контакта.");
			Возврат;
		КонецЕсли;
		
		МассивФИО = СтрРазделить(СокрЛП(ФИО), " ", Ложь);
		
		Фамилия = "";
		Имя = "";
		Отчество = "";
		
		КоличествоСлов = МассивФИО.Количество();
		
		Если КоличествоСлов > 0 Тогда
			Фамилия = МассивФИО[0];
		КонецЕсли;
		
		Если КоличествоСлов > 1 Тогда
			Имя = МассивФИО[1];
		КонецЕсли;
		Если КоличествоСлов > 2 Тогда
			Отчество = МассивФИО[2];
		КонецЕсли;
		
		СоздатьЭлементКонтакта(Имя, Отчество, Фамилия, ЭлектроннаяПочта, Телефон);
		
		ФИО = "";
		ЭлектроннаяПочта = "";
		Телефон = "";
		
		ПоказатьПредупреждение(, "Контакт успешно создан в локальной учетной записи.");
	#КонецЕсли
	
КонецПроцедуры

&НаКлиенте
Процедура СоздатьЭлементКонтакта(Имя, Отчество, Фамилия, ЭлектроннаяПочта,Телефон)
	
	#Если МобильноеПриложениеКлиент Тогда
		
		ДанныеКонтакта = Новый ДанныеКонтакта;
		
		ДанныеКонтакта.Фамилия = Фамилия;
		ДанныеКонтакта.Имя = Имя;
		ДанныеКонтакта.Отчество = Отчество;
		
		Если Не ПустаяСтрока(ЭлектроннаяПочта) Тогда
			ЭлементПочта = Новый ЭлементДанныхКонтакта(ТипАдресаЭлектроннойПочтыДанныхКонтакта.Рабочий, ЭлектроннаяПочта);
			ДанныеКонтакта.АдресаЭлектроннойПочты.Добавить(ЭлементПочта);
		КонецЕсли;
		
		Если Не ПустаяСтрока(Телефон) Тогда
			ЭлементТелефон = Новый ЭлементДанныхКонтакта(ТипНомераТелефонаДанныхКонтакта.Рабочий, Телефон);
			ДанныеКонтакта.НомераТелефонов.Добавить(ЭлементТелефон);
		КонецЕсли;
		
		МенеджерКонтактов = Новый МенеджерКонтактов;
		ЛокальныеКонтакты = МенеджерКонтактов.ПолучитьЛокальнуюУчетнуюЗаписьКонтактов();
		Контакт = Новый ДанныеКонтактаУчетнойЗаписи(ДанныеКонтакта, ЛокальныеКонтакты);
		
		МенеджерКонтактов.ДобавитьКонтакт(Контакт);
		
	#КонецЕсли
	
КонецПроцедуры
