
&НаКлиенте
Процедура Войти(Команда)
	
	Если Не ЗначениеЗаполнено(Логин) Тогда
		ПоказатьПредупреждение(, "Заполните логин.");
		Возврат;
	КонецЕсли;
	
	Результат = ПроверитьАвторизациюНаСервере(Логин, Пароль);
	
	Если Результат.Успех Тогда
		ПоказатьОповещениеПользователя("Вход выполнен", , "Добро пожаловать, " + Результат.ИмяПользователя);
		Закрыть(Истина); // Закрываем форму авторизации
	Иначе
		ПоказатьПредупреждение(, Результат.Сообщение);
	КонецЕсли;
	
	СисИнфо = Новый СистемнаяИнформация;
	Идентификатор = Строка(СисИнфо.ИдентификаторКлиента);
	УстановитьИдентификаторПриложения(Идентификатор);
	
КонецПроцедуры

&НаСервере
Функция ПроверитьАвторизациюНаСервере(Логин, Пароль)
	
	Результат = Новый Структура("Успех, ИмяПользователя, Сообщение", Ложь, "", "");
	
	Попытка
		// Указываем адрес твоего веб-сервера, порт, логин и пароль курьера
		Соединение = Новый HTTPСоединение(
		"192.168.0.18", // Или IP-адрес сервера
		80,               // Порт (80 для HTTP или 443 для HTTPS)
		Логин,            // Логин из формы
		Пароль,           // Пароль из формы
		,
		10                // Таймаут 10 секунд
		// Если используется HTTPS, добавь 7-м параметром: Новый ЗащищенноеСоединениеOpenSSL()
		);
		
		// Указываем путь публикации базы + /hs/ + ИмяСервиса + Шаблон
		Запрос = Новый HTTPЗапрос("/CentralBase/hs/mobile/authorization");
		
		// Ответ = Соединение.Получить(Запрос); 
		Ответ = Соединение.ОтправитьДляОбработки(Запрос);
		
		Если Ответ.КодСостояния = 200 Тогда
			// Читаем ответ от 1С
			ТелоОтвета = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
			ЧтениеJSON = Новый ЧтениеJSON;
			ЧтениеJSON.УстановитьСтроку(ТелоОтвета);
			ДанныеОтвета = ПрочитатьJSON(ЧтениеJSON, Ложь);
			ЧтениеJSON.Закрыть();
			
			Результат.Успех = Истина;
			Результат.ИмяПользователя = ДанныеОтвета.ИмяПользователя;
			
			
		ИначеЕсли Ответ.КодСостояния = 401 Тогда
			Результат.Сообщение = "Неверный логин или пароль!";
		ИначеЕсли Ответ.КодСостояния = 403 Тогда
			Результат.Сообщение = "У пользователя нет прав доступа к сервису!";
		Иначе
			Результат.Сообщение = "Ошибка сервера. Код: " + Ответ.КодСостояния;
		КонецЕсли;
		
	Исключение
		Результат.Сообщение = "Не удалось подключиться к серверу: " + ОписаниеОшибки();
	КонецПопытки;
	
	Возврат Результат;
	
КонецФункции 

&НаСервере
Процедура УстановитьИдентификаторПриложения(Идентификатор)
	
	Если Константы.ИдентификаторПриложения.Получить() <> Идентификатор Тогда
		
		Константы.ИдентификаторПриложения.Установить(Идентификатор);
		Сообщить("Идентификатор не равен константе.");
	Иначе 
		Сообщить("Идентификатор равен константе.");
	КонецЕсли;
	
КонецПроцедуры



