// Обмен с центральной базой: получение изменений документов "Доставка",
// зарегистрированных для узла плана обмена этого устройства.

#Область ОбработчикиКомандФормы

&НаКлиенте
Процедура ВыполнитьОбмен(Команда)
	
	Если НЕ ЗначениеЗаполнено(АдресСервераЦентральнойБазы) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Не заполнен адрес сервера центральной базы.'"));
		Возврат;
	КонецЕсли;
	
	ДокументыОбмена.Очистить();
	ЖурналОбмена = "";
	
	ЭндпоинтОбмена = "/hs/mobile/exchange";
	Ответ = СвязьСЦентральнойБазой.ОбменСЦентральнойБазой(АдресСервераЦентральнойБазы, ЛогинКурьера, ПарольКурьера, ЭндпоинтОбмена);
	
	Если Ответ.КодСостояния <> 200 Тогда
		ЖурналОбмена = СтрШаблон(НСтр("ru = 'Ошибка обмена. Код состояния: %1'"), Ответ.КодСостояния);
		ПоказатьПредупреждение(, ЖурналОбмена);
		Возврат;
	КонецЕсли;
	
	ТелоОтвета = Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8);
	ПрименитьДанныеОбмена(ТелоОтвета);
	
	ПоказатьОповещениеПользователя(НСтр("ru = 'Обмен завершен.'"), , ЖурналОбмена);
	
КонецПроцедуры

#КонецОбласти

#Область ОбработчикиСобытийФормы

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	АдресСервераЦентральнойБазы = Константы.АдресСервераЦентральнойБазы.Получить();
	ЛогинКурьера = Константы.ЛогинКурьераЦентральнойБазы.Получить();
	ПарольКурьера = Константы.ПарольКурьераЦентральнойБазы.Получить();
	
КонецПроцедуры

#КонецОбласти

#Область СлужебныеПроцедурыИФункции

// Разбирает ответ сервиса и записывает полученные документы в базу мобильного приложения.
//
// Параметры:
//  ТелоОтвета - Строка - тело ответа HTTP-сервиса в формате JSON.
//
&НаСервере
Процедура ПрименитьДанныеОбмена(ТелоОтвета)
	
	ДокументыОбмена.Очистить();
	ЖурналОбмена = "";
	
	ЧтениеJSON = Новый ЧтениеJSON;
	ЧтениеJSON.УстановитьСтроку(ТелоОтвета);
	ДанныеОтвета = ПрочитатьJSON(ЧтениеJSON);
	ЧтениеJSON.Закрыть();
	
	Если ТипЗнч(ДанныеОтвета) <> Тип("Структура") ИЛИ НЕ ДанныеОтвета.Свойство("Документы") Тогда
		ЖурналОбмена = НСтр("ru = 'Некорректный ответ сервера.'");
		Возврат;
	КонецЕсли;
	
	Для Каждого ДанныеДокумента Из ДанныеОтвета.Документы Цикл
		
		СтрокаОбмена = ДокументыОбмена.Добавить();
		СтрокаОбмена.Номер = ДанныеДокумента.Номер;
		СтрокаОбмена.Дата = XMLЗначение(Тип("Дата"), ДанныеДокумента.Дата);
		СтрокаОбмена.Контрагент = ДанныеДокумента.Контрагент;
		
		Попытка
			СтрокаОбмена.Результат = ЗаписатьДокументДоставки(ДанныеДокумента);
		Исключение
			СтрокаОбмена.Результат = СтрШаблон(НСтр("ru = 'Ошибка записи: %1'"), ИнформацияОбОшибке().КраткоеПредставление);
		КонецПопытки;
		
	КонецЦикла;
	
	ЖурналОбмена = СтрШаблон(НСтр("ru = 'Узел: %1. Номер сообщения: %2. Получено документов: %3.'"),
		ДанныеОтвета.КодУзла, ДанныеОтвета.НомерСообщения, ДокументыОбмена.Количество());
	
КонецПроцедуры

// Создает или обновляет документ "Доставка" по данным, полученным от центральной базы.
//
// Параметры:
//  ДанныеДокумента - Структура - реквизиты документа из ответа сервиса.
//
// Возвращаемое значение:
//  Строка - результат записи для журнала обмена.
//
&НаСервере
Функция ЗаписатьДокументДоставки(ДанныеДокумента)
	
	Ссылка = Документы.Доставка.ПолучитьСсылку(Новый УникальныйИдентификатор(ДанныеДокумента.Ссылка));
	
	ОбъектДокумента = Ссылка.ПолучитьОбъект();
	ЭтоНовыйДокумент = (ОбъектДокумента = Неопределено);
	
	Если ЭтоНовыйДокумент Тогда
		ОбъектДокумента = Документы.Доставка.СоздатьДокумент();
		ОбъектДокумента.УстановитьСсылкуНового(Ссылка);
	КонецЕсли;
	
	ОбъектДокумента.Дата = XMLЗначение(Тип("Дата"), ДанныеДокумента.Дата);
	ОбъектДокумента.Номер = ДанныеДокумента.Номер;
	ОбъектДокумента.Контрагент = ДанныеДокумента.Контрагент;
	ОбъектДокумента.АдресДоставки = ДанныеДокумента.АдресДоставки;
	ОбъектДокумента.Комментарий = ДанныеДокумента.Комментарий;
	ОбъектДокумента.Статус = СтатусПоПредставлению(ДанныеДокумента.Статус);
	
	Если ДанныеДокумента.Свойство("Удалён") Тогда
		ОбъектДокумента.ПометкаУдаления = ДанныеДокумента["Удалён"];
	КонецЕсли;
	
	ОбъектДокумента.Товары.Очистить();
	Для Каждого ДанныеТовара Из ДанныеДокумента.Товары Цикл
		СтрокаТоваров = ОбъектДокумента.Товары.Добавить();
		СтрокаТоваров.Номенклатура = Справочники.Номенклатура.НайтиПоНаименованию(ДанныеТовара.Номенклатура, Истина);
		СтрокаТоваров.Количество = ДанныеТовара.Количество;
	КонецЦикла;
	
	ОбъектДокумента.Записать(РежимЗаписиДокумента.Запись);
	
	Возврат ?(ЭтоНовыйДокумент, НСтр("ru = 'Создан'"), НСтр("ru = 'Обновлен'"));
	
КонецФункции

// Определяет значение перечисления "СтатусыДоставок" по его представлению.
//
// Параметры:
//  ПредставлениеСтатуса - Строка - представление статуса, полученное от центральной базы.
//
// Возвращаемое значение:
//  ПеречислениеСсылка.СтатусыДоставок - найденный статус или пустая ссылка.
//
&НаСервере
Функция СтатусПоПредставлению(ПредставлениеСтатуса)
	
	Для Каждого ЗначениеПеречисления Из Метаданные.Перечисления.СтатусыДоставок.ЗначенияПеречисления Цикл
		Статус = Перечисления.СтатусыДоставок[ЗначениеПеречисления.Имя];
		Если Строка(Статус) = ПредставлениеСтатуса Тогда
			Возврат Статус;
		КонецЕсли;
	КонецЦикла;
	
	Возврат Перечисления.СтатусыДоставок.ПустаяСсылка();
	
КонецФункции

#КонецОбласти

