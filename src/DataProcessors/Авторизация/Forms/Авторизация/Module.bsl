
&НаКлиенте
Процедура ВойтиВСистему(Команда)
	
	// Проверка заполнения данных для авторизации логин, пароль и адрес сервера.
	Если Не ЗначениеЗаполнено(АдресСервераЦентральнойБазы) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Не заполнено поле Адрес сервера.'"));
		Возврат;
	КонецЕсли;
	
	Если Не ЗначениеЗаполнено(ЛогинКурьера) Тогда
		ПоказатьПредупреждение(, НСтр("ru = 'Не заполнено поле Логин курьера.'"));
		Возврат;
	КонецЕсли;
	
	// Проверка отключена для для учебной версии
	//Если Не ЗначениеЗаполнено(ПарольКурьера) Тогда
	//	// ПоказатьПредупреждение(, НСтр("ru = 'Не заполнено поле Пароль курьера.'"));
	//	// Возврат;
	//КонецЕсли;
	
	// Настраиваем связь с сервером
	
	//РезультатАвторизации = Неопределено;
	Ответ = СвязьСЦентральнойБазой.АвторизацияНаСервере(АдресСервераЦентральнойБазы, ЛогинКурьера, ПарольКурьера);
	
	//	
	//	// 6. Проверяем результат аутентификации по коду состояния HTTP
	Если Ответ.КодСостояния = 200 Тогда
		
		// Читаем имя пользователя и ИдентификаторКлиента из ответа сервера
		ЧтениеJSON = Новый ЧтениеJSON;
		ЧтениеJSON.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8));
		ДанныеОтвета = ПрочитатьJSON(ЧтениеJSON);
		ЧтениеJSON.Закрыть();
		
		// Выводим всплывающее оповещение пользователя
		ТекстОповещения = СтрШаблон(НСтр("ru = 'Добро пожаловать, %1 (%2)'"),
		ДанныеОтвета.ПолноеИмяПользователя,
		ДанныеОтвета.ИдентификаторМобильногоУстройства);
		ПоказатьОповещениеПользователя(НСтр("ru = 'Авторизация успешна!'"), , ТекстОповещения);
		
		Закрыть(Истина);
		//
		//ОткрытьФорму("Обработка.ДоставкаЗаказов.Форма");
		
		// Здесь можно сохранить СтрокаBase64 в локальное хранилище мобильной базы для следующих запросов
			
	ИначеЕсли Ответ.КодСостояния = 401 Тогда
		
		//Сообщить("Неверный логин или пароль.");
		ТекстОповещения = СтрШаблон(НСтр("ru = 'Неверный логин или пароль.'"));
		ПоказатьОповещениеПользователя(НСтр("ru = 'Ошибка авторизации.'"), , ТекстОповещения);
		
		Возврат;
		
	ИначеЕсли Ответ.КодСостояния = 403 Тогда
		
		//Сообщить("У вашей учетной записи нет прав на использование мобильного сервиса.");
		ТекстОповещения = СтрШаблон(НСтр("ru = 'У вашей учетной записи нет прав на использование мобильного сервиса."));
		ПоказатьОповещениеПользователя(НСтр("ru = 'Ошибка авторизации.'"), , ТекстОповещения);
		
		Возврат;
		
	Иначе
		// Сообщить("Непредвиденный ответ сервера. Код: " + Ответ.КодСостояния);
		ТекстОповещения = СтрШаблон(НСтр("ru = 'Код ошибки: %1'"), Ответ.КодСостояния);
		ПоказатьОповещениеПользователя(НСтр("ru = 'Ошибка авторизации.'"), , ТекстОповещения);
		
		Возврат;
	КонецЕсли;
	
КонецПроцедуры

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)
	
	АдресСервераЦентральнойБазы = Константы.АдресСервераЦентральнойБазы.Получить();
	ЛогинКурьера = Константы.ЛогинКурьераЦентральнойБазы.Получить();
	ПарольКурьера = Константы.ПарольКурьераЦентральнойБазы.Получить();
	
КонецПроцедуры

&НаКлиенте
Процедура АдресЦентральнойБазыПриИзменении(Элемент)
	
	СохранитьПараметрыПодключенияКЦентральнойБазе();
	
КонецПроцедуры

&НаКлиенте
Процедура ЛогинКурьераПриИзменении(Элемент)
	
	СохранитьПараметрыПодключенияКЦентральнойБазе();
	
КонецПроцедуры

&НаКлиенте
Процедура ПарольКурьераПриИзменении(Элемент)
	
	СохранитьПараметрыПодключенияКЦентральнойБазе();
	
КонецПроцедуры

&НаСервере
Процедура СохранитьПараметрыПодключенияКЦентральнойБазе()
	
	Константы.АдресСервераЦентральнойБазы.Установить(АдресСервераЦентральнойБазы);
	Константы.ЛогинКурьераЦентральнойБазы.Установить(ЛогинКурьера);
	Константы.ПарольКурьераЦентральнойБазы.Установить(ПарольКурьера);
	
КонецПроцедуры

