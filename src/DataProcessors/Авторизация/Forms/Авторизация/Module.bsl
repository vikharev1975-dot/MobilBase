
&НаКлиенте
Процедура ВойтиВСистему(Команда)
	
	// 1. Проверяем, что пользователь не оставил поля пустыми
	//	Если Не ЗначениеЗаполнено(Логин) Или Не ЗначениеЗаполнено(Пароль) Тогда
		Если Не ЗначениеЗаполнено(Логин) Тогда
			Сообщить("Пожалуйста, введите логин и пароль.");
			Возврат;
		КонецЕсли;
		
		// 2. Формируем строку для Basic-аутентификации формата "Логин:Пароль" и кодируем в Base64
		СтрокаУчетныхДанных = СокрЛП(Логин) + ":" + Пароль;
		ДвоичныеДанные = ПолучитьДвоичныеДанныеИзСтроки(СтрокаУчетныхДанных, КодировкаТекста.UTF8);
		СтрокаBase64 = Base64Строка(ДвоичныеДанные);
		
		// Обязательно удаляем переносы строк, которые 1С вставляет каждые 76 символов
		СтрокаBase64 = СтрЗаменить(СтрокаBase64, Символы.ПС, "");
		СтрокаBase64 = СтрЗаменить(СтрокаBase64, Символы.ВК, "");
		
		// 3. Настраиваем соединение с сервером (логин и пароль в конструктор НЕ передаем)
		АдресСервера = "192.168.0.18"; // Укажи домен или IP-адрес твоего веб-сервера
		Порт = 80; // 443 для HTTPS, 80 для обычного HTTP
		// ЗащищенноеСоединение = Новый ЗащищенноеСоединениеOpenSSL(); // Для HTTP без SSL передай Неопределено
		
		ЗащищенноеСоединение = Неопределено;
		
		Соединение = Новый HTTPСоединение(
		АдресСервера,
		Порт,
		, // Пользователь пустой (передадим в заголовке)
		, // Пароль пустой (передадим в заголовке)
		, // Прокси
		10, // Таймаут 10 секунд
		ЗащищенноеСоединение
		);
		
		СисИнфо = Новый СистемнаяИнформация;
			
		// 4. Формируем HTTP-запрос с заголовком Authorization и идентификатором устройства
		// Формат пути: /<ИмяПубликации>/hs/<КорневойURL>/<ШаблонURL>
		Запрос = Новый HTTPЗапрос("/CentralBase/hs/mobile/login");
		Запрос.Заголовки.Вставить("Authorization", "Basic " + СтрокаBase64);
		Запрос.Заголовки.Вставить("X-MobileID", Строка(СисИнфо.ИдентификаторКлиента));
		
		// 5. Отправляем запрос на сервер
		Попытка
			Ответ = Соединение.Получить(Запрос);
		Исключение
			Сообщить("Нет связи с сервером: " + ОписаниеОшибки());
			Возврат;
		КонецПопытки;
		
		// 6. Проверяем результат аутентификации по коду состояния HTTP
		Если Ответ.КодСостояния = 200 Тогда
			
			// Читаем имя авторизованного пользователя из ответа сервера
			ЧтениеJSON = Новый ЧтениеJSON;
			ЧтениеJSON.УстановитьСтроку(Ответ.ПолучитьТелоКакСтроку(КодировкаТекста.UTF8));
			ДанныеОтвета = ПрочитатьJSON(ЧтениеJSON);
			ЧтениеJSON.Закрыть();
			
			Сообщить("Авторизация успешна! Добро пожаловать, " + ДанныеОтвета["full_name"]);
			// Здесь можно сохранить СтрокаBase64 в локальное хранилище мобильной базы для следующих запросов
			
		ИначеЕсли Ответ.КодСостояния = 401 Тогда
			Сообщить("Неверный логин или пароль.");
			
		ИначеЕсли Ответ.КодСостояния = 403 Тогда
			Сообщить("У вашей учетной записи нет прав на использование мобильного сервиса.");
			
		Иначе
			Сообщить("Непредвиденный ответ сервера. Код: " + Ответ.КодСостояния);
		КонецЕсли;
		
	
КонецПроцедуры
